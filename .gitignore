# Dependencies
node_modules/
.pnp
.pnp.js

# Strapi
.strapi/
.strapi-updater.json
.strapi-cloud.json
dist/
build/
.cache/
.tmp/
exports/
*.db
*.sqlite

# Uploaded media is content, not code. It lives on the server's persistent
# disk and is backed up separately — a repo clone carries none of it.
public/uploads/*
!public/uploads/.gitkeep

# Secrets
.env
.env.*
!.env.example
.seed-token

# Migration cache — a re-fetchable snapshot of the live WordPress site.
# out/ IS committed: those are decision artifacts.
# Scraped and generated migration artifacts — large, and reproducible by
# re-running the fetch/extract scripts.
#
# NOT translations/. That is hand-authored source: the Arabic homepage copy
# lives there and cannot be regenerated from anything. It was silently
# untracked, so the whole translation existed on one machine and a fresh
# clone could not rebuild the Arabic homepage at all. git will not descend
# into an excluded directory, so the parent has to be `data/*` rather than
# `data/` for the negation below to be reachable.
migration/data/*
!migration/data/translations/

# OS / editor
.DS_Store
*.log

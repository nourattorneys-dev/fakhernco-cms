# Copy to .env and fill in. Never commit .env.
# Regenerate every secret per environment — do not reuse across projects.
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

HOST=0.0.0.0
PORT=1337

# --- Secrets ---------------------------------------------------------------
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Production URL --------------------------------------------------------
# MUST be set in production, e.g. https://cms.fakhernco.com
# Unset, Strapi emits http://localhost:1337 media URLs and every image on the
# site 404s. It looks like a front-end bug; it is this variable.
PUBLIC_URL=

# Set true behind the cPanel/nginx proxy so Strapi trusts X-Forwarded-*.
# Unset, it refuses to set secure cookies and admin login fails with no
# useful error message.
IS_PROXIED=false

# --- Database --------------------------------------------------------------
# Local development: sqlite. Production: mysql.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# MySQL (production). On cPanel both the database and the user are prefixed
# with the account name, e.g. fakhernco_cms / fakhernco_strapi.
#
# Create the database as utf8mb4 or Arabic content is silently mangled:
#   CREATE DATABASE fakhernco_cms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Strapi runs a schema sync on every boot, so the user needs CREATE, ALTER,
# DROP, INDEX and REFERENCES — not just SELECT/INSERT/UPDATE/DELETE.
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=fakhernco_cms
# DATABASE_USERNAME=fakhernco_strapi
# DATABASE_PASSWORD=
# DATABASE_CHARSET=utf8mb4

# --- Email -----------------------------------------------------------------
# fakhernco.com's MX points at Microsoft 365.
# Port 587 uses STARTTLS; 465 uses implicit TLS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx   # Resend API key. Never commit this.
SMTP_FROM_EMAIL=noreply@send.fakhernco.com   # must be a domain verified in Resend

# Where contact enquiries are sent. Unset, submissions are still saved but
# NOBODY IS NOTIFIED and the only trace is a warning in the log.
CONTACT_NOTIFY_EMAIL=info@fakhernco.com   # where enquiry alerts arrive

# --- Front end -------------------------------------------------------------
# Shared secret for the Next.js revalidation webhook.
REVALIDATE_SECRET=

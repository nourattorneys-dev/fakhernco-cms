{
    "kind": "collectionType",
    "collectionName": "landing_pages",
    "info": {
        "singularName": "landing-page",
        "pluralName": "landing-pages",
        "displayName": "Landing page",
        "description": "Campaign landing pages for paid search. Served noindex and kept out of the sitemap, because each one duplicates a service page that already ranks organically."
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "title": {
            "type": "string",
            "pluginOptions": { "i18n": { "localized": true } },
            "required": true,
            "description": "Short service name. Used on the index and the 'other services' cards, not as the page heading."
        },
        "slug": {
            "type": "uid",
            "pluginOptions": { "i18n": { "localized": true } },
            "targetField": "title",
            "required": true
        },
        "h1": {
            "type": "string",
            "pluginOptions": { "i18n": { "localized": true } },
            "required": true,
            "description": "The page heading, and the message-match anchor. Should echo the ad headline closely — Google scores landing-page relevance against the ad that sent the click."
        },
        "subhead": {
            "type": "text",
            "pluginOptions": { "i18n": { "localized": true } },
            "description": "One line under the h1. Also used as the description on the 'other services' cards."
        },
        "heroImage": {
            "type": "media",
            "multiple": false,
            "allowedTypes": ["images"],
            "pluginOptions": { "i18n": { "localized": false } },
            "description": "Full-bleed hero photograph. Choose one whose subject matches the service."
        },
        "seo": {
            "type": "component",
            "repeatable": false,
            "component": "shared.seo",
            "pluginOptions": { "i18n": { "localized": true } }
        },
        "order": {
            "type": "integer",
            "pluginOptions": { "i18n": { "localized": false } },
            "default": 0
        },
        "blocks": {
            "type": "dynamiczone",
            "components": [
                "blocks.heading",
                "blocks.paragraph",
                "blocks.list",
                "blocks.faq",
                "blocks.image",
                "blocks.quote"
            ],
            "pluginOptions": { "i18n": { "localized": true } }
        }
    }
}
